# Local development environment. Copy to .env and adjust. NEVER
# commit the .env file. The default values are placeholders only;
# production deployments must use real secrets supplied by the
# deployer's secret manager.

# --- API runtime ----------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Web (public env visible to the browser) -----------------------
# Used by apps/web (NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Mobile (Expo public env) ---------------------------------------
# Consumed by apps/mobile via Constants.expoConfig.extra.
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Database (PostgreSQL) ------------------------------------------
# Consumed by apps/api in later phases.
DATABASE_URL=postgresql://ecc:change-me-in-real-use@localhost:5432/ecc
POSTGRES_DB=ecc
POSTGRES_USER=ecc
POSTGRES_PASSWORD=change-me-in-real-use
POSTGRES_PORT=5433

# --- Redis ----------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# --- Object storage (S3 / MinIO) ------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecc-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-in-real-use
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-real-use
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Auth -----------------------------------------------------------
# 64+ chars recommended. Replace before any non-local use.
JWT_ACCESS_SECRET=replace-me-with-a-64-character-random-string-aaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-me-with-a-different-64-character-random-string-bbbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS -----------------------------------------------------------
# Comma-separated list. Mobile clients are not subject to CORS; this
# controls the web origin(s) that may call the API.
WEB_ALLOWED_ORIGINS=http://localhost:3001

# --- Logging --------------------------------------------------------
LOG_LEVEL=info
