# Local development environment — reference template.
#
# Copy to `.env` for local use. NEVER commit the resulting `.env` file.
# Every variable below is annotated with its consumer and whether it is
# required. Phase 19 audited this file against actual code: variables that
# nothing reads were removed, and missing ones were added. If you change a
# variable here, confirm the code or tooling actually consumes it.
#
# The API does NOT load this file automatically (there is no dotenv /
# ConfigModule in the project). Variables must be exported into the
# environment that starts the process — e.g. `env $(grep -v '^#' .env | xargs)`.
# docker-compose.yml interpolates the "infrastructure" section below
# directly from the shell environment or a root .env file.

# ============================================================================
# API runtime (consumed by apps/api)
# ============================================================================

# REQUIRED (all environments). PostgreSQL connection string.
# NOTE: the host port must match POSTGRES_PORT below (5433 by default),
# because compose publishes the container's 5432 on the host as 5433.
DATABASE_URL=postgresql://ecc:change-me-in-real-use@localhost:5433/ecc

# REQUIRED in production (apps/api refuses to start without it).
# Directory for uploaded documents (protected health information).
# The directory is created 0700 and files are written 0600. In development
# it defaults to ./uploads inside the app directory.
STORAGE_DIR=./uploads

# REQUIRED in production. Access-token signing secret: >= 32 characters and
# not a placeholder; the process refuses to start otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me

# Optional. Port the API listens on. Default 3000.
PORT=3000

# Optional. `production` is required for production behaviour:
# secure refresh cookie, mandatory JWT secret, mandatory STORAGE_DIR.
# Do NOT set this to `test` in a deployed environment — it changes
# application behaviour (see docs/PHASE_19_DEPLOYMENT_OPERATIONAL_READINESS.md).
NODE_ENV=development

# TEST-ONLY. Set by the test harness (src/testing/setup-env.ts); never set
# it in a deployed environment. When NODE_ENV=test AND this is "1", the
# in-process auth rate limiter is bypassed. It is ignored entirely when
# NODE_ENV=production.
ECC_TEST_DISABLE_RATE_LIMIT=

# ============================================================================
# Web (public, build-time — consumed by apps/web)
# ============================================================================
# Baked into the browser bundle at build time. Never put a secret here.
# The web app's own port is set by the deployment, not here.
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================================================
# Web (server-only, run-time — consumed by apps/web)
# ============================================================================
# Phase 50. Read by the server-side API client the web app's route handlers
# use for their server-to-server calls to the API (apps/web/src/lib/api-client.ts).
#
# SERVER-ONLY BY NAME. It has no NEXT_PUBLIC_ prefix, so Next.js does not
# inline it into the browser bundle; it is substituted on the server at
# request time. Do not rename it to NEXT_PUBLIC_API_INTERNAL_URL — that would
# publish the backend's address to every browser.
#
# It carries no secret: it is an address, not a credential.
#
# Optional. When the variable is ABSENT the server-side client falls back to
# NEXT_PUBLIC_API_URL, then to http://localhost:3000. Set it when the address
# the browser should use and the address the web server should use differ —
# for example a public API URL for the browser and an internal service name
# such as http://ecc-api:3000 for the container-to-container hop. Leave it
# unset to let the fallback apply; an EMPTY value is not the same as unset and
# yields a relative URL. The /health page still reads NEXT_PUBLIC_API_URL;
# only the server-side client reads this.
API_INTERNAL_URL=http://localhost:3000

# ============================================================================
# Local infrastructure (consumed by docker-compose.yml only)
# ============================================================================
# The application does not connect to Redis or MinIO today: Redis has no
# client in the code, and document storage is the local filesystem via
# STORAGE_DIR. These services exist for local development parity only.

# PostgreSQL container (also interpolated into DATABASE_URL above).
POSTGRES_DB=ecc
POSTGRES_USER=ecc
POSTGRES_PASSWORD=change-me-in-real-use
POSTGRES_PORT=5433

# Redis container — no application consumer.
REDIS_PORT=6380

# MinIO container (S3-compatible) — no application consumer.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-real-use
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ecc-documents
