{
  "name": "@ecc/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Expo React Native app for the elderly care coordination platform.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo \"(mobile uses expo prebuild + EAS in later phases; phase 1 is a typecheck-only build)\" && tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(mobile vitest pipeline lands in Phase 14 alongside the Expo test runner)\" && exit 0",
    "clean": "rm -rf node_modules .expo .turbo dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@ecc/config": "workspace:*",
    "@ecc/types": "workspace:*",
    "@ecc/ui": "workspace:*",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "@babel/core": "^7.25.2",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  }
}
