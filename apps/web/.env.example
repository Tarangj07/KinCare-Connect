# Web app local development. NEXT_PUBLIC_* values are visible to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-only (Phase 50). NOT prefixed NEXT_PUBLIC_ on purpose: the browser must
# never see it. Used by the server-side API client in src/lib/api-client.ts for
# its server-to-server calls to the API. Optional — when ABSENT it falls back to
# NEXT_PUBLIC_API_URL and then to http://localhost:3000. Set it only when the
# browser-facing URL and the server-to-server URL differ. An EMPTY value is not
# the same as absent and yields a relative URL; comment the line out instead.
API_INTERNAL_URL=http://localhost:3000
