# API service environment configuration.
NODE_ENV=development
PORT=3000

# --- Required -------------------------------------------------------------
# PostgreSQL connection string. Required in every environment.
DATABASE_URL=

# JWT signing secret for access tokens.
# Required in production: must be >= 32 characters and must not be a
# placeholder. The process refuses to start otherwise (see
# src/config/security-config.ts). In development a random ephemeral key is
# generated per process and a warning is logged.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me

# Access-token lifetime (15m) and refresh-cookie lifetime (30d) are fixed in
# code (src/app.module.ts, src/auth/auth.service.ts, src/auth/auth.controller.ts)
# and are intentionally not configurable via the environment.

# Directory for uploaded document files.
# Required when NODE_ENV=production. Without it the service falls back to
# ./uploads inside the application directory, which is refused in production
# because document contents are protected health information. The directory
# is created owner-only (0700) and files are written owner-only (0600).
STORAGE_DIR=

# --- Local development infrastructure -------------------------------------
# Defined in docker-compose.yml. Redis and MinIO exist for local parity
# only; the application has no Redis or S3 client today, so there is no
# variable to set for either. The current storage backend is the local
# filesystem described by STORAGE_DIR above.
#
# Phase 23: REDIS_URL was removed from this template. It was documented
# here but read by nothing, so an operator could set it and believe it took
# effect. The root .env.example documents the compose-only variables
# (REDIS_PORT and the MINIO_* pair) that genuinely configure the local
# containers. scripts/verify-config-contract.mjs fails if a variable is
# documented but unread, so it cannot be reintroduced silently.
