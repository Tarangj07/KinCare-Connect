// =============================================================================
// Elderly Care Coordination Platform — Prisma schema
// -----------------------------------------------------------------------------
// This is the authoritative data model for the platform. See
// `docs/DATABASE.md` for the design rationale, ownership model,
// authorization relationships, index decisions, and deletion strategy.
// -----------------------------------------------------------------------------
// Phase: 2 — Database schema + Prisma.
// Engine: PostgreSQL 16.
// ID strategy: UUIDv4 via `gen_random_uuid()` (pgcrypto) so that PKs are
//   generated by the database and not by the application.
// Naming: snake_case for column names; Prisma maps them to camelCase fields.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

/// Global account role. Used for non-resource routes (`/admin/*`).
/// Resource-level authorization is enforced by `CareCircleMember.role`,
/// not by this enum.
enum GlobalRole {
  USER
  SUPER_ADMIN
}

/// Per-care-circle role. This is the authorization backbone: a user is
/// permitted to act on a senior only if they hold an appropriate role
/// in a `CareCircleMember` row that includes that senior. Membership
/// itself is the access control list.
enum CircleRole {
  FAMILY_ADMIN
  FAMILY_MEMBER
  CAREGIVER
  DOCTOR
  OBSERVER
}

/// Status of a member's relationship to a care circle.
enum CircleMemberStatus {
  ACTIVE
  PENDING
  ENDED
}

/// Per-organization role (e.g. organisation admin, organisation caregiver).
/// Separate from `CircleRole` because organisation membership is a
/// different relationship from care-circle membership.
enum OrganizationRole {
  ORG_ADMIN
  ORG_MEMBER
}

/// Medication dose status — drives the medication-adherence state machine.
/// Pending -> Taken / Skipped / Missed / Snoozed.
enum DoseStatus {
  PENDING
  TAKEN
  SKIPPED
  MISSED
  SNOOZED
}

/// Appointment status.
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Care task status.
enum CareTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
  OVERDUE
}

/// Care task priority (UI only — does not change authorization).
enum CareTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Recurrence frequency for tasks and reminders.
enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

/// Family-update post visibility.
enum PostVisibility {
  CIRCLE
  ORGANIZATION
  PRIVATE
}

/// Emergency alert states. The state machine is documented in
/// `docs/DATABASE.md` §6.
enum EmergencyAlertStatus {
  DETECTED
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
  FALSE_ALARM
}

/// Emergency alert severity.
enum EmergencyAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Audit log actor types.
enum AuditActorType {
  USER
  OPERATOR
  SYSTEM
  WEBHOOK
}

/// Notification channel.
enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

/// Subscription plan tier.
enum SubscriptionPlan {
  FREEMIUM
  FAMILY_PREMIUM
  ORGANIZATION
  ENTERPRISE
}

/// Subscription lifecycle.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Health measurement source — manual, device, or system-imported.
enum MeasurementSource {
  MANUAL
  DEVICE
  IMPORT
  SYSTEM
}

/// Family-admin invitation lifecycle.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// =============================================================================
// Identity & access
// =============================================================================

/// Core user account. A `User` is the *login* identity; it is
/// distinct from a `SeniorProfile`, which is the *person-being-cared-for*
/// identity. A senior who never logs in has no `User` row. A senior
/// who does log in has both: a `User` row (with `seniorProfileId`
/// pointing to their `SeniorProfile`) and the `SeniorProfile` row.
model User {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String  @unique
  emailVerified   Boolean @default(false)
  /// Argon2id hash of the user's password. Never stored in plaintext.
  passwordHash    String  @map("password_hash")
  /// The senior profile this user *is*, if any. 1:1 with `SeniorProfile`.
  /// Most users will not be seniors and will have `seniorProfileId = null`.
  seniorProfileId String? @unique @map("senior_profile_id") @db.Uuid

  /// Lockout bookkeeping for brute-force protection.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  /// Global role. Most users will be `USER`; only operators get
  /// `SUPER_ADMIN`. Resource-level authorization is independent
  /// of this field and lives in `CareCircleMember`.
  globalRole GlobalRole @default(USER) @map("global_role")

  /// True if the user has set up TOTP (Phase 16).
  totpEnabled Boolean @default(false) @map("totp_enabled")

  /// Profile basics. Health information lives on `SeniorProfile`,
  /// not here.
  fullName        String  @map("full_name")
  preferredLocale String  @default("en") @map("preferred_locale")
  phone           String?
  profilePhotoUrl String? @map("profile_photo_url")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  seniorProfile              SeniorProfile?            @relation("UserIsSenior", fields: [seniorProfileId], references: [id], onDelete: SetNull)
  organizationMemberships    OrganizationMembership[]
  circleMemberships          CareCircleMember[]
  circleMembershipsCreated   CareCircle[]              @relation("CircleCreatedBy")
  refreshTokens              RefreshToken[]
  invitationsIssued          Invitation[]              @relation("InvitationIssuedBy")
  invitationsAccepted        Invitation[]              @relation("InvitationAcceptedBy")
  documentsUploaded          HealthDocument[]
  familyUpdatesPosted        FamilyUpdate[]
  commentsPosted             Comment[]
  messagesSent               Message[]
  conversationParticipations ConversationParticipant[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  measurementsRecorded       HealthMeasurement[]
  devicesOwned               HealthDevice[]            @relation("DeviceOwner")
  caregiverProfile           CaregiverProfile?

  @@index([globalRole])
  @@index([deletedAt])
  @@map("users")
}

/// Refresh token record. We do not store the JWT itself; we store a
/// SHA-256 hash of the random 256-bit secret, plus an opaque jti for
/// rotation/revocation. Plaintext tokens are never persisted. Phase 3
/// will use this table; it is created now so migrations stay clean.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// The family id — rotation chains share this id. Reuse of a token
  /// in a revoked family triggers whole-family revocation.
  familyId     String    @map("family_id") @db.Uuid
  /// Opaque JWT id (`jti`).
  jti          String    @unique
  /// SHA-256 of the token's secret half. Allows verification without
  /// storing the token in plaintext.
  tokenHash    String    @map("token_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// The id of the token that replaced this one, if any.
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaced   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// Tenancy
// =============================================================================

/// Tenant container. Null `organizationId` on a resource means it
/// belongs to a private family (no organisation).
model Organization {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String  @unique
  /// Optional per-tenant contact. Not PII; just the org's main email/phone.
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members       OrganizationMembership[]
  seniors       SeniorOrganizationMembership[]
  subscriptions OrganizationSubscription[]

  @@index([deletedAt])
  @@map("organizations")
}

/// Membership of a user in an organisation. The role here is the
/// user's role *within the organisation* (admin, staff). It is
/// independent of `CareCircleMember.role`, which controls access to
/// specific seniors.
model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(ORG_MEMBER)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

// =============================================================================
// Senior, care circles, caregivers
// =============================================================================

/// A senior is the person being cared for. May or may not have a
/// login (`User.seniorProfileId`). Health information lives here
/// and in dedicated health entities; we do not duplicate it
/// unnecessarily.
model SeniorProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String    @map("full_name")
  preferredName   String?   @map("preferred_name")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  /// Free-form care preferences (e.g. "prefers morning visits").
  carePreferences String?   @map("care_preferences") @db.Text

  /// Optional primary address. We keep it separate from PHI.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String? @db.Char(2)

  /// Care notes that are not health information — for example
  /// "lives alone, no pets", "morning person".
  generalNotes String? @map("general_notes") @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user                  User?                          @relation("UserIsSenior")
  memberships           SeniorOrganizationMembership[]
  careCircles           CareCircle[]
  careCircleMemberships CareCircleMember[]
  primaryCaregivers     CaregiverProfile[]             @relation("SeniorPrimaryCaregiver")
  emergencyContacts     EmergencyContact[]
  medications           Medication[]
  appointments          Appointment[]
  careTasks             CareTask[]
  healthMeasurements    HealthMeasurement[]
  healthDocuments       HealthDocument[]
  familyUpdates         FamilyUpdate[]
  messages              Message[]
  conversations         Conversation[]
  notifications         Notification[]
  consentRecords        Consent[]
  emergencyAlerts       EmergencyAlert[]
  medicationDoses       MedicationDose[]
  reminders             Reminder[]
  auditLogs             AuditLog[]
  documentAccesses      DocumentAccess[]

  @@index([deletedAt])
  @@index([fullName])
  @@map("senior_profiles")
}

/// Many-to-many between seniors and organisations. A senior may be
/// enrolled in zero (private family), one, or several organisations.
model SeniorOrganizationMembership {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId       String    @map("senior_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// When the membership begins. Null = since the dawn of time.
  startsAt       DateTime? @map("starts_at") @db.Timestamptz(6)
  /// When the membership ends. Null = currently active.
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  senior       SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([seniorId, organizationId])
  @@index([organizationId, endsAt])
  @@index([seniorId])
  @@map("senior_organization_memberships")
}

/// A care circle groups the people who coordinate care for a senior.
/// The circle is the unit of authorization: a user's access to a
/// senior flows through their `CareCircleMember` rows. Multiple
/// circles may be attached to a senior (e.g. an inner family circle
/// and an outer clinical circle), each with its own membership list.
model CareCircle {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The senior whose care this circle coordinates. We model the
  /// circle as 1:1 with a senior for MVP because it keeps the
  /// authorization question ("can user X see senior Y?") a single
  /// join. Phase 4 can introduce a many-to-many if needed.
  seniorId    String  @map("senior_id") @db.Uuid
  name        String
  /// Free-form description ("Inner family", "Clinical team").
  description String? @db.Text
  /// The user who created the circle. Audit-relevant.
  createdById String  @map("created_by_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior    SeniorProfile      @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  createdBy User               @relation("CircleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members   CareCircleMember[]

  @@unique([seniorId, name])
  @@index([seniorId])
  @@index([deletedAt])
  @@map("care_circles")
}

/// Membership in a care circle. This is the **access control list**
/// for the senior: presence here (with `status = ACTIVE`) is what
/// gives a user access. Authorization joins go through this table.
model CareCircleMember {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId String  @map("circle_id") @db.Uuid
  /// Either a `User` (most common) or a `SeniorProfile` (a senior
  /// themselves participating in their own care). The application
  /// layer ensures exactly one of these is non-null.
  userId   String? @map("user_id") @db.Uuid
  seniorId String? @map("senior_id") @db.Uuid

  role        CircleRole
  status      CircleMemberStatus @default(ACTIVE)
  /// Optional human-friendly display name within this circle.
  displayName String?            @map("display_name")
  /// Free-form notes (e.g. "Daughter — visits Sundays").
  notes       String?            @db.Text
  /// When the relationship ends. Null = currently active.
  endsAt      DateTime?          @map("ends_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  circle CareCircle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senior SeniorProfile? @relation(fields: [seniorId], references: [id], onDelete: Cascade)

  /// A given user can only be in a circle once.
  @@unique([circleId, userId])
  /// A given senior can only be in a circle once.
  @@unique([circleId, seniorId])
  @@index([userId, status])
  @@index([seniorId, status])
  @@index([circleId, role])
  @@map("care_circle_members")
}

/// Profile fields specific to a caregiver (a person who delivers
/// care — a doctor, nurse, aide, or family member who actively
/// provides care). Separate from `User` because the fields are
/// care-specific (qualifications, employer) and not all users are
/// caregivers.
model CaregiverProfile {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String  @unique @map("user_id") @db.Uuid
  /// Optional link to a primary senior (the one this caregiver
  /// primarily supports). Other relationships are expressed via
  /// `CareCircleMember`.
  primarySeniorId        String? @map("primary_senior_id") @db.Uuid
  /// Employer organization if any.
  employerOrganizationId String? @map("employer_organization_id") @db.Uuid

  qualifications             String?   @db.Text
  /// Background check completed timestamp. Sensitive; do not expose
  /// without explicit authorization.
  backgroundCheckCompletedAt DateTime? @map("background_check_completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  primarySenior SeniorProfile? @relation("SeniorPrimaryCaregiver", fields: [primarySeniorId], references: [id], onDelete: SetNull)

  @@index([primarySeniorId])
  @@map("caregiver_profiles")
}

/// Emergency contact for a senior. Separate from `CareCircleMember`
/// because emergency contacts are not authorized users — they are
/// people to be *notified*, not people who can log in.
model EmergencyContact {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId     String  @map("senior_id") @db.Uuid
  fullName     String  @map("full_name")
  relationship String?
  phone        String
  email        String?
  /// Order in the notification cascade. 1 = first.
  priority     Int     @default(1)
  notes        String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)

  @@index([seniorId, priority])
  @@map("emergency_contacts")
}

// =============================================================================
// Medications
// =============================================================================

/// A medication *definition* for a senior. The schedule is separate
/// (`MedicationSchedule`) so adherence can be tracked per dose, not
/// just per medication.
model Medication {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId String @map("senior_id") @db.Uuid

  name             String
  /// Free-form dosage ("500 mg", "1 tablet").
  dosage           String
  /// Form ("tablet", "liquid", "injection").
  form             String?
  /// Free-form instructions ("with food", "before bed").
  instructions     String? @db.Text
  /// Prescribing clinician name; we do not link a `User` here in MVP.
  prescribedByName String? @map("prescribed_by_name")
  /// Optional pharmacy info.
  pharmacyName     String? @map("pharmacy_name")
  pharmacyPhone    String? @map("pharmacy_phone")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  /// Whether the medication is currently active.
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior    SeniorProfile        @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  schedules MedicationSchedule[]
  doses     MedicationDose[]

  @@index([seniorId, isActive])
  @@index([seniorId, deletedAt])
  @@map("medications")
}

/// Daily schedule of times at which a medication should be taken.
/// One medication may have multiple schedules (e.g. "1 tab at 08:00,
/// 1 tab at 20:00"). The schedule is a *pattern*; the actual dose
/// instances are `MedicationDose` rows generated from this pattern.
model MedicationSchedule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicationId String   @map("medication_id") @db.Uuid
  /// Time of day at which the dose is due (UTC; senior's local
  /// timezone is on the profile). Phase 5 will handle conversion.
  timeOfDay    DateTime @map("time_of_day") @db.Time(6)
  /// Dose quantity at this scheduled time.
  quantity     Decimal  @db.Decimal(10, 3)
  /// Optional unit override ("mg", "tablets", "mL").
  unit         String?
  /// Optional note attached to this scheduled time.
  note         String?
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  medication Medication       @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  doses      MedicationDose[]

  @@index([medicationId])
  @@map("medication_schedules")
}

/// A concrete, scheduled-or-elapsed dose. Generated from
/// `MedicationSchedule`; carries the actual outcome (TAKEN, SKIPPED,
/// MISSED, SNOOZED). This is the unit of adherence.
model MedicationDose {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Direct FK to the senior for fast "today's doses for senior X"
  /// queries; the medication is denormalised for the same reason.
  seniorId     String     @map("senior_id") @db.Uuid
  medicationId String     @map("medication_id") @db.Uuid
  scheduleId   String?    @map("schedule_id") @db.Uuid
  /// When the dose is/was due.
  scheduledAt  DateTime   @map("scheduled_at") @db.Timestamptz(6)
  /// When the dose was actually recorded (taken, skipped, etc.).
  recordedAt   DateTime?  @map("recorded_at") @db.Timestamptz(6)
  status       DoseStatus @default(PENDING)

  /// Optional user who recorded the dose. May be null for
  /// system-generated MISSED rows.
  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid
  /// Optional note from the recorder.
  note             String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  senior     SeniorProfile       @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  medication Medication          @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  schedule   MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// A scheduled time is unique per medication + scheduled timestamp.
  @@unique([medicationId, scheduledAt])
  @@index([seniorId, scheduledAt])
  @@index([seniorId, status])
  @@index([status, scheduledAt])
  @@map("medication_doses")
}

// =============================================================================
// Appointments
// =============================================================================

/// An appointment for a senior (doctor visit, hospital, telehealth).
model Appointment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId String @map("senior_id") @db.Uuid

  title        String
  /// Doctor / clinic / hospital name. We don't link a `User` for MVP.
  providerName String? @map("provider_name")
  /// Free-form location ("St. Mary's Hospital, Room 4B", "Zoom link: …").
  location     String?
  /// True if remote (telehealth). UI hint; does not change data.
  isTelehealth Boolean @default(false) @map("is_telehealth")

  startsAt DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime?         @map("ends_at") @db.Timestamptz(6)
  status   AppointmentStatus @default(SCHEDULED)
  notes    String?           @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior       SeniorProfile            @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  participants AppointmentParticipant[]
  reminders    Reminder[]

  @@index([seniorId, startsAt])
  @@index([seniorId, status])
  @@index([startsAt])
  @@map("appointments")
}

/// People attending an appointment (in addition to the senior).
model AppointmentParticipant {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String  @map("appointment_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid
  /// Display name if the participant is not a user (e.g. a clinician
  /// who is not on the platform).
  externalName  String? @map("external_name")
  /// Role at the appointment ("driver", "interpreter", …).
  role          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
  @@index([userId])
  @@map("appointment_participants")
}

/// Generic reminder configuration attached to an appointment. We
/// keep this as a separate table so a single appointment can have
/// multiple reminders (24h, 2h, 30m) and the same shape can be reused
/// for medication/care-task reminders later.
model Reminder {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId      String              @map("senior_id") @db.Uuid
  appointmentId String?             @map("appointment_id") @db.Uuid
  /// Offset from the event start, in minutes. -1440 = 24h before.
  offsetMinutes Int                 @map("offset_minutes")
  /// Where the reminder goes.
  channel       NotificationChannel @default(IN_APP)
  /// True once the reminder has been delivered.
  deliveredAt   DateTime?           @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  senior      SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([seniorId, appointmentId])
  @@index([deliveredAt])
  @@map("reminders")
}

// =============================================================================
// Care tasks
// =============================================================================

/// A care task for a senior. Examples: "check blood pressure",
/// "prepare meal", "doctor appointment", "walk".
model CareTask {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId    String           @map("senior_id") @db.Uuid
  title       String
  description String?          @db.Text
  priority    CareTaskPriority @default(MEDIUM)
  status      CareTaskStatus   @default(PENDING)

  /// When the task is due.
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  /// When the task was completed (or otherwise closed).
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  recurrenceFrequency RecurrenceFrequency @default(NONE) @map("recurrence_frequency")
  /// For CUSTOM recurrence, the rrule or iCal string. Null otherwise.
  recurrenceRule      String?             @map("recurrence_rule")
  /// Date the recurrence series ends. Null = open-ended.
  recurrenceEndsAt    DateTime?           @map("recurrence_ends_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior      SeniorProfile        @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  assignments CareTaskAssignment[]

  @@index([seniorId, dueAt])
  @@index([seniorId, status])
  @@index([status, dueAt])
  @@map("care_tasks")
}

/// Assignment of a care task to a user. A task may be assigned to
/// multiple users (joint responsibility) and a user may have many
/// tasks. The `endsAt` here is for fixed-engagement caregivers.
model CareTaskAssignment {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId   String    @map("task_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  /// Optional role note ("primary", "backup").
  role     String?
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task CareTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([endsAt])
  @@map("care_task_assignments")
}

// =============================================================================
// Health measurements
// =============================================================================

/// Type catalogue for health measurements. Adding a new measurement
/// is a row insert, not a schema change.
model HealthMeasurementType {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Machine key, e.g. "blood_pressure", "glucose".
  key         String  @unique
  displayName String  @map("display_name")
  /// Default unit for this measurement.
  defaultUnit String? @map("default_unit")
  /// Component schema for structured measurements.
  ///   - For "scalar": { "kind": "scalar" }
  ///   - For "compound" (e.g. blood pressure): { "kind": "compound", "components": ["systolic","diastolic"] }
  /// The shape is enforced in the application layer.
  schema      Json
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  measurements HealthMeasurement[]

  @@map("health_measurement_types")
}

/// A measurement instance. Value is stored as JSONB so we can hold
/// both scalar and compound measurements without a wide table.
/// Examples:
///   { "kind": "scalar", "value": 72, "unit": "bpm" }      // heart rate
///   { "kind": "scalar", "value": 110, "unit": "mg/dL" }  // glucose
///   { "kind": "compound", "components": { "systolic": 120, "diastolic": 80, "unit": "mmHg" } }
model HealthMeasurement {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId String  @map("senior_id") @db.Uuid
  typeId   String  @map("type_id") @db.Uuid
  /// Free-form device the measurement came from. If non-null, the
  /// row is owned by the device; if null, it was recorded manually.
  deviceId String? @map("device_id") @db.Uuid

  /// Structured value. See model doc above.
  value            Json
  /// Measurement timestamp as reported by the recorder / device.
  measuredAt       DateTime          @map("measured_at") @db.Timestamptz(6)
  /// Source of the measurement.
  source           MeasurementSource @default(MANUAL)
  /// Optional user who recorded the measurement (may be null for
  /// device-only entries).
  recordedByUserId String?           @map("recorded_by_user_id") @db.Uuid

  /// Optional free-form note.
  note String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete: we do not destroy health data on user request;
  /// we set `deletedAt` and stop surfacing it. This is a deliberate
  /// choice for safety against accidental loss.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior     SeniorProfile         @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  type       HealthMeasurementType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  device     HealthDevice?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  recordedBy User?                 @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([seniorId, typeId, measuredAt])
  @@index([typeId, measuredAt])
  @@index([seniorId, measuredAt])
  @@map("health_measurements")
}

/// A health device registered for a senior. The actual integration
/// (HealthKit, Health Connect, a Bluetooth pillbox, etc.) is an
/// adapter registered against the `provider` string. Phase 9 builds
/// the adapter interface; Phase 20 wires real providers.
model HealthDevice {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The user who registered the device — typically a family admin
  /// or the senior themselves. This is *not* a measurement; it's
  /// device ownership.
  ownerUserId String  @map("owner_user_id") @db.Uuid
  provider    String // e.g. "apple_health_kit", "fitbit", "mock"
  externalId  String? @map("external_id")
  displayName String  @map("display_name")
  /// Free-form metadata (model, firmware).
  metadata    Json?

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner        User                @relation("DeviceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  measurements HealthMeasurement[]

  @@unique([provider, externalId])
  @@index([ownerUserId])
  @@map("health_devices")
}

// =============================================================================
// Documents
// =============================================================================

/// Metadata for a private document (prescription, insurance card,
/// report). The actual file is in object storage; the database
/// stores only the key and a content hash.
model HealthDocument {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId         String @map("senior_id") @db.Uuid
  /// The user who uploaded the file.
  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid

  title           String
  /// Free-form category ("prescription", "insurance", "report").
  category        String?
  /// MIME type as sniffed at upload.
  contentType     String    @map("content_type")
  /// File size in bytes.
  sizeBytes       BigInt    @map("size_bytes")
  /// Storage key inside the bucket. The actual URL is generated
  /// on demand and never persisted.
  storageKey      String    @unique @map("storage_key")
  /// SHA-256 of the bytes, for integrity verification.
  contentHash     String    @map("content_hash")
  /// Optional description / notes.
  description     String?   @db.Text
  /// Whether the document has been scanned for malware (Phase 12).
  scanStatus      String    @default("pending") @map("scan_status")
  scanCompletedAt DateTime? @map("scan_completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete by default; hard delete requires an explicit admin
  /// action and is recorded in the audit log.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior       SeniorProfile    @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  accessGrants DocumentAccess[]

  @@index([seniorId, deletedAt])
  @@index([uploadedByUserId])
  @@map("health_documents")
}

/// Per-document access grant. A user with a row here is permitted
/// to download this document (subject to the same overall circle
/// authorization; this row is additive, not permissive). Used to
/// extend access beyond the senior's care circle.
model DocumentAccess {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String    @map("document_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  seniorId        String    @map("senior_id") @db.Uuid
  /// Granted until. Null = open-ended.
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  /// Who granted it. Audit-relevant.
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  document HealthDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  senior   SeniorProfile  @relation(fields: [seniorId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@index([seniorId])
  @@map("document_accesses")
}

// =============================================================================
// Family feed
// =============================================================================

/// A care-feed post ("Mom's appointment completed.", "Blood pressure
/// recorded.", "Medication taken."). Visibility is filterable.
model FamilyUpdate {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId     String @map("senior_id") @db.Uuid
  authorUserId String @map("author_user_id") @db.Uuid

  body              String         @db.Text
  visibility        PostVisibility @default(CIRCLE)
  /// Optional structured kind ("medication_taken", "appointment_completed", "measurement_recorded", "free_form").
  kind              String?
  /// Optional foreign key into the related entity (medication, appointment, etc.).
  /// The kind field tells you which table.
  relatedEntityType String?        @map("related_entity_type")
  relatedEntityId   String?        @map("related_entity_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior   SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  comments Comment[]

  @@index([seniorId, createdAt])
  @@index([seniorId, kind, createdAt])
  @@index([authorUserId])
  @@map("family_updates")
}

/// A comment on a `FamilyUpdate`. Threaded one level deep in MVP.
model Comment {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  updateId     String  @map("update_id") @db.Uuid
  authorUserId String  @map("author_user_id") @db.Uuid
  body         String  @db.Text
  /// Optional parent comment id for threading.
  parentId     String? @map("parent_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  update  FamilyUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  parent  Comment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[]    @relation("CommentThread")

  @@index([updateId, createdAt])
  @@index([authorUserId])
  @@map("comments")
}

// =============================================================================
// Secure messaging
// =============================================================================

/// A messaging conversation. Conversations are scoped to a senior
/// for MVP (e.g. "the care circle for Grandma's care"). A
/// conversation may have many participants.
model Conversation {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Required: every conversation is about a senior.
  seniorId String  @map("senior_id") @db.Uuid
  /// Optional title. Defaults to a generated one in the API layer.
  title    String?
  /// True if the conversation is closed for new messages.
  isClosed Boolean @default(false) @map("is_closed")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  senior       SeniorProfile             @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([seniorId, updatedAt])
  @@index([seniorId, deletedAt])
  @@map("conversations")
}

/// Conversation membership. The intersection of "circle member" and
/// "conversation participant" — must be a circle member to be a
/// conversation participant, enforced in the application layer.
model ConversationParticipant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Last time the user read messages in this conversation.
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  /// When the user joined.
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime? @map("left_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// A single message in a conversation.
model Message {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderUserId   String @map("sender_user_id") @db.Uuid
  /// Optional denormalised senior for fast "messages about senior X"
  /// queries. Authoritative FK is on the conversation.
  seniorId       String @map("senior_id") @db.Uuid

  body      String  @db.Text
  /// Optional reply-to message id.
  replyToId String? @map("reply_to_id") @db.Uuid
  /// True once the message has been edited.
  isEdited  Boolean @default(false) @map("is_edited")
  /// True once the message is soft-deleted.
  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  senior       SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  replyTo      Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([seniorId, createdAt])
  @@map("messages")
}

// =============================================================================
// Notifications
// =============================================================================

/// A notification dispatched to a user. `deliveredAt` is set when
/// the worker hands it off to the channel; `readAt` is set when the
/// user sees it in the app.
model Notification {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  /// Optional senior the notification is about. Most notifications
  /// are about a senior; system notifications have `seniorId = null`.
  seniorId String? @map("senior_id") @db.Uuid

  /// Notification type key ("medication.due", "appointment.upcoming", "care_task.overdue", …).
  kind    String
  /// Free-form payload. Should not include PHI in clear text; the
  /// server should render the message from the kind + ids at delivery.
  payload Json
  /// Channel the notification is intended for.
  channel NotificationChannel @default(IN_APP)

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  senior SeniorProfile? @relation(fields: [seniorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([seniorId, kind])
  @@map("notifications")
}

/// Per-user, per-channel preferences. Missing rows mean "use the
/// default" (e.g. opted in to in-app, opted out of email).
model NotificationPreference {
  id      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  channel NotificationChannel
  /// The notification kind these prefs apply to. Null = default for this channel.
  kind    String?
  /// True if the user wants to receive notifications of this kind/channel.
  enabled Boolean             @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, kind])
  @@index([userId])
  @@map("notification_preferences")
}

// =============================================================================
// Emergency alerts
// =============================================================================

/// An emergency alert. The state machine:
///
///   DETECTED -> ACKNOWLEDGED -> RESOLVED
///           |              \-> FALSE_ALARM
///           \-> ESCALATED -> (DETECTED) -> ACKNOWLEDGED -> ...
///
/// Phase 13 implements the transitions; the table is created now
/// so migrations stay clean.
model EmergencyAlert {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId             String                 @map("senior_id") @db.Uuid
  /// Alert type key ("fall_detected", "missed_medication_window", "manual", …).
  kind                 String
  severity             EmergencyAlertSeverity @default(MEDIUM)
  status               EmergencyAlertStatus   @default(DETECTED)
  /// Free-form message ("Possible fall detected in living room").
  message              String?                @db.Text
  /// Source of the alert ("wearable", "manual", "system").
  source               String
  /// Time the alert was raised.
  detectedAt           DateTime               @map("detected_at") @db.Timestamptz(6)
  acknowledgedAt       DateTime?              @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedByUserId String?                @map("acknowledged_by_user_id") @db.Uuid
  escalatedAt          DateTime?              @map("escalated_at") @db.Timestamptz(6)
  resolvedAt           DateTime?              @map("resolved_at") @db.Timestamptz(6)
  resolution           String?                @map("resolution") @db.Text
  /// External identifier (e.g. the device's event id), for de-dup.
  externalId           String?                @map("external_id")
  /// Arbitrary structured context (sensor reading, etc.). Do not
  /// place PHI here without encryption.
  context              Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  senior SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)

  @@unique([seniorId, source, externalId])
  @@index([seniorId, status])
  @@index([status, severity, detectedAt])
  @@map("emergency_alerts")
}

// =============================================================================
// Audit log
// =============================================================================

/// Append-oriented audit log. The application role has no
/// `UPDATE` or `DELETE` permission on this table; that is enforced
/// in the database grant script in Phase 16.
///
/// Entries reference an actor (`actorUserId` is null for SYSTEM /
/// OPERATOR actions), the action performed, the resource touched,
/// and a metadata blob. Sensitive data should be referenced by id
/// rather than duplicated into the log.
model AuditLog {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorType    AuditActorType @default(USER) @map("actor_type")
  /// Optional senior context — most actions are about a senior.
  seniorId     String?        @map("senior_id") @db.Uuid
  /// Action key ("auth.login", "circle.member.added", "medication.created", …).
  action       String
  /// Resource type ("user", "senior_profile", "medication", "document", …).
  resourceType String         @map("resource_type")
  /// Resource id. May be a UUID or any string for non-DB resources.
  resourceId   String         @map("resource_id")
  /// Free-form metadata. Do not place PHI or secrets here.
  metadata     Json?
  /// Request id (correlates with the API request log).
  requestId    String?        @map("request_id")
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  senior SeniorProfile? @relation(fields: [seniorId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([seniorId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// =============================================================================
// Consent
// =============================================================================

/// A record of consent given by a senior (or their authorised
/// representative) for a particular scope of data sharing. Consent
/// is distinct from authorization: a user may be authorized to see
/// a senior's data, but a consent record is required for the
/// *types* of data they can see (e.g. clinical notes, measurements).
model Consent {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seniorId      String  @map("senior_id") @db.Uuid
  /// Optional granter user. Null when consent is given by the senior
  /// directly and they have no login.
  granterUserId String? @map("granter_user_id") @db.Uuid

  /// Scope of consent ("share_with_care_circle", "health_integration", "document_access", "device_data", "research").
  scope            String
  /// Free-form details (e.g. the integration name, the specific document id).
  details          Json?
  /// When the consent takes effect. Defaults to now() at insert time.
  grantedAt        DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// When the consent expires. Null = open-ended.
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  /// When the consent was revoked. Null = still in force.
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Reason for revocation (free text).
  revocationReason String?   @map("revocation_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  senior SeniorProfile @relation(fields: [seniorId], references: [id], onDelete: Cascade)

  @@index([seniorId, scope])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("consents")
}

// =============================================================================
// Invitations
// =============================================================================

/// Invitation to join a care circle (and create a `User` if the
/// invitee does not yet have one). The token is sent by email in
/// Phase 4. Here we store only the metadata; the actual token is
/// a hash.
model Invitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The senior whose care circle is being joined.
  seniorId         String           @map("senior_id") @db.Uuid
  /// Optional organization context.
  organizationId   String?          @map("organization_id") @db.Uuid
  /// User who issued the invitation.
  issuedByUserId   String           @map("issued_by_user_id") @db.Uuid
  /// Email of the invitee. May match an existing user or be new.
  inviteeEmail     String           @map("invitee_email")
  /// The role the invitee will have if they accept.
  role             CircleRole
  /// Token SHA-256. The plaintext token is emailed; only the hash is stored.
  tokenHash        String           @map("token_hash")
  status           InvitationStatus @default(PENDING)
  /// Optional pre-created `User` if the invitee already has an account.
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  /// When the invitation expires.
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  /// Free-form message from the inviter.
  message          String?          @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  issuedBy   User  @relation("InvitationIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([inviteeEmail, status])
  @@index([seniorId, status])
  @@index([expiresAt])
  @@map("invitations")
}

// =============================================================================
// Subscriptions
// =============================================================================

/// A subscription for an organization (organization-billed plans).
/// Individual family plans attach to a `userId` instead. We use a
/// `subjectType` discriminator to keep a single table for MVP.
model OrganizationSubscription {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  plan                   SubscriptionPlan
  status                 SubscriptionStatus @default(TRIAL)
  /// When the current period starts.
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  /// When the current period ends.
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  /// External billing-system id (Stripe customer/subscription id).
  /// Stored opaque; we do not call out to billing in MVP.
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([currentPeriodEnd])
  @@map("organization_subscriptions")
}

/// A family-premium or freemium subscription. We model this on
/// `User` (not on `SeniorProfile`) because the buyer is the user.
model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  plan                   SubscriptionPlan
  status                 SubscriptionStatus @default(TRIAL)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}
