{
  "name": "@ecc/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS HTTP + WebSocket API for the elderly care coordination platform.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:verify": "node scripts/verify-build-determinism.mjs",
    "verify:metadata": "node scripts/verify-decorator-metadata.mjs",
    "verify:metadata:mutate": "node scripts/mutate-decorator-metadata.mjs",
    "verify:routes": "node scripts/verify-route-authorization.mjs",
    "verify:routes:mutate": "node scripts/mutate-route-authorization.mjs",
    "verify:lifetime:mutate": "node scripts/mutate-token-lifetime.mjs",
    "verify:auth:compiled": "node scripts/verify-compiled-auth-suite.mjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "prisma db seed",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:watch": "vitest --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.e2e.ts",
    "test:all": "vitest run",
    "test:cov": "vitest run --config vitest.config.unit.ts --coverage",
    "clean": "rm -rf node_modules dist .turbo *.tsbuildinfo coverage"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@ecc/config": "workspace:*",
    "@ecc/types": "workspace:*",
    "@ecc/validation": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^10.4.6",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^7.2.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
